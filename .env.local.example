# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Cloud Console > APIs & Services > Credentials)
# Needs the Drive API enabled and the drive.readonly scope on the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Admin SDK (Firebase Console > Project Settings > Service Accounts >
# Generate new private key). Used server-side only — never exposed to the client.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend (resend.com > API Keys) — sends the "Invite guests" email.
# Without a verified sending domain, Resend only delivers from
# onboarding@resend.dev and only to the email your Resend account itself is
# registered under (their sandbox restriction) — set RESEND_FROM_EMAIL once
# you verify a real domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
