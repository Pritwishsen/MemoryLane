rules_version = '2';

// Every read/write in this app goes through a Next.js API route using the
// Firebase Admin SDK (which bypasses these rules entirely), gated by the
// NextAuth session server-side — see src/lib/session.ts. The browser never
// talks to Firestore directly, so client access is denied outright here.
// Paste this into Firebase Console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
